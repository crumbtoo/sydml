cabal-version:      3.0
name:               sydml
version:            0.1.0.0
synopsis: A compiler for an ML in Haskell's clothes.
description: A compiler for an ML in Haskell's clothes.
license:            GPL-3.0-only
license-file:       LICENSE
author:             crumbtoo
maintainer:         lomiskiam@gmail.com
-- copyright:
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common common
  ghc-options:
    -- -Wall
    -Wno-typed-holes

  default-extensions:
    BlockArguments
    DataKinds
    DeriveGeneric
    DeriveTraversable
    DerivingVia
    FlexibleContexts
    GADTs
    GeneralisedNewtypeDeriving
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedStrings
    PartialTypeSignatures
    PatternSynonyms
    StandaloneDeriving
    TypeApplications
    TypeFamilies
    MultiWayIf

  ghc-options:
    -fdefer-typed-holes
  default-language: GHC2021

--------------------------------------------------------------------------------
-- sydml

library
  import:           common
  -- cabal-fmt: expand sydml/src/ -Main
  exposed-modules:
    Data.Located
    Data.PrettyP
    Sydc
    Sydc.Driver
    Sydc.Error
    Sydc.Monad
    Sydc.Query
    Sydc.Types
    SydPrelude

  default-language: GHC2021
  include-dirs: tree-sitter-sydml/src
  includes:     tree_sitter/parser.h
  install-includes: tree_sitter/parser.h
  cxx-sources: tree-sitter-sydml/src/parser.c
  build-depends:
                  base ^>=4.19.1.0
                , bytestring
                , comonad
                , containers
                , data-fix
                , dependent-sum-template     ^>=0.2.0.1
                , deriving-compat
                , effectful
                , filepath
                , free
                , generic-lens               ^>=2.2.0.0
                , hashable
                , lens                       >=5.0.0     && <6.0.0.0
                , lsp
                , megaparsec
                , monadic-recursion-schemes
                , mtl
                , parser-combinators
                , pretty-simple
                , prettyprinter
                , qbe
                , recursion-schemes          >=5.0.0     && <6.0.0.0
                , rock                       >=0.3.1.0   && <0.4.0.0.0
                , semigroupoids
                , some
                , text                       >=2.0 && <2.2
                , text-short
                , these
                , transformers
                , tree-sitter
                , unordered-containers
                , witherable
  hs-source-dirs:   sydml/src

executable sydc
    import:           common
    main-is:          Main.hs
    default-language: GHC2021

    other-modules:
      Command.Batch

    -- other-extensions:
    build-depends:
                    base ^>=4.19.1.0
                  , lens
                  , optparse-applicative
                  , sydml

    hs-source-dirs:   sydml/app

test-suite sydml-test
    import:           common
    type:             exitcode-stdio-1.0
    hs-source-dirs:   sydml/test
    main-is:          Main.hs
    other-modules:
      SydmlTests.EmptyInput
    build-depends:
      , base ^>=4.19.1.0
      , tasty-hunit ^>=0.10
      , tasty-golden ^>=2.3
      , tasty-program >=1.1 && <=1.2
      , tasty >=1.2.2 && <1.6
      , sydml

--------------------------------------------------------------------------------
-- presydc

library presydml
  import: common
  -- cabal-fmt: expand presydml/src/ -Main
  exposed-modules:
    ANF
    SSA
    Lam.Syntax
    SydPrelude

  default-language: GHC2021
  build-depends:
      base ^>=4.19.1.0
    , lens                       >=5.3.0     && <6.0.0
    , pretty-simple
    , prettyprinter
    , qbe
    , rock                       >=0.3.1.0   && <0.4.0.0.0
    , effectful
    , text                       >=2.0 && <2.2
    , text-short
    , unordered-containers
    , containers
    , hashable
    , mtl
    , transformers
    , generic-lens               ^>=2.2.0.0
  hs-source-dirs: presydml/src

executable presydc
  hs-source-dirs: presydml/app
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
      base ^>=4.19.1.0
    , presydml
    , lens                       >=5.3.0     && <6.0.0
    , generic-lens               ^>=2.2.0.0
    , pretty-simple
    , prettyprinter
    , qbe
    , rock                       >=0.3.1.0   && <0.4.0.0.0
    , effectful
    , text                       >=2.0 && <2.2
