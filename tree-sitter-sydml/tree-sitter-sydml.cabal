cabal-version:       2.2
name:                tree-sitter-sydml
version:             0.7.0.3
synopsis:            Tree-sitter grammar/parser for SydML
description:         This package provides a parser for SydML suitable for use with the tree-sitter package.
license:             BSD-3-Clause
author:              Madeleine Sydney
category:            Tree-sitter
build-type:          Simple
data-files:          src/node-types.json
                   , test/corpus/*.txt
-- extra-doc-files:     ChangeLog.md

library
  exposed-modules:     TreeSitter.SydML
  autogen-modules:     Paths_tree_sitter_sydml
  other-modules:       Paths_tree_sitter_sydml
  build-depends:       base >= 4.12 && < 5
                     , tree-sitter
  include-dirs:        src
  install-includes:    tree_sitter/parser.h
  c-sources:           src/parser.c
  default-language:    Haskell2010
